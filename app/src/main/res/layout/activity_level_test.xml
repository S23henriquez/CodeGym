<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:paddingHorizontal="24dp">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:fontFamily="@font/space_mono"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTestProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 10"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/space_mono" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressTest"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressTint="?attr/colorPrimary"
        android:progressBackgroundTint="@color/surface2"
        android:layout_marginBottom="28dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/level_test_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="@font/syne_extrabold"
        android:layout_marginBottom="8dp" />

    <!-- PREGUNTA -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">
        <TextView
            android:id="@+id/tvTestQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4"
            android:fontFamily="@font/space_mono" />
    </com.google.android.material.card.MaterialCardView>

    <!-- OPCIONES -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/surface2"
        app:strokeColor="@color/border"
        app:strokeWidth="2dp"
        app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
            <TextView android:layout_width="28dp" android:layout_height="28dp"
                android:id="@+id/tvOptALetter" android:text="A" android:gravity="center"
                android:textColor="?attr/colorPrimary" android:textSize="12sp" android:textStyle="bold"
                android:fontFamily="@font/space_mono" android:background="@drawable/circle_red_outline" />
            <TextView android:id="@+id/tvOptA" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="@font/space_mono" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/surface2"
        app:strokeColor="@color/border"
        app:strokeWidth="2dp"
        app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
            <TextView android:layout_width="28dp" android:layout_height="28dp"
                android:id="@+id/tvOptBLetter" android:text="B" android:gravity="center"
                android:textColor="?attr/colorPrimary" android:textSize="12sp" android:textStyle="bold"
                android:fontFamily="@font/space_mono" android:background="@drawable/circle_red_outline" />
            <TextView android:id="@+id/tvOptB" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="@font/space_mono" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/surface2"
        app:strokeColor="@color/border"
        app:strokeWidth="2dp"
        app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
            <TextView android:layout_width="28dp" android:layout_height="28dp"
                android:id="@+id/tvOptCLetter" android:text="C" android:gravity="center"
                android:textColor="?attr/colorPrimary" android:textSize="12sp" android:textStyle="bold"
                android:fontFamily="@font/space_mono" android:background="@drawable/circle_red_outline" />
            <TextView android:id="@+id/tvOptC" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="@font/space_mono" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/surface2"
        app:strokeColor="@color/border"
        app:strokeWidth="2dp"
        app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
            <TextView android:layout_width="28dp" android:layout_height="28dp"
                android:id="@+id/tvOptDLetter" android:text="D" android:gravity="center"
                android:textColor="?attr/colorPrimary" android:textSize="12sp" android:textStyle="bold"
                android:fontFamily="@font/space_mono" android:background="@drawable/circle_red_outline" />
            <TextView android:id="@+id/tvOptD" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="@font/space_mono" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="32dp"
        android:text="@string/level_test_confirm"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="?attr/colorPrimary"
        android:fontFamily="@font/syne_extrabold"
        android:visibility="gone"
        app:cornerRadius="14dp" />

</LinearLayout>



