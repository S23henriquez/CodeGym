<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- HEADER UNIDAD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvUnitNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_label"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:fontFamily="@font/space_mono"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAiBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_badge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:fontFamily="@font/space_mono"
                android:visibility="gone"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvLockIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUnitTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/syne_extrabold"
            android:layout_marginBottom="10dp" />

        <!-- SEPARADOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvUnitTopics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="@font/space_mono"
            android:lineSpacingMultiplier="1.6" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>




